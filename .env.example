# Copy to .env.local for local development. Everything below
# DATABASE_URL has a safe development fallback (see src/lib/env.ts) and
# is only strictly required when NODE_ENV=production.

# Required in every environment, dev included — src/lib/db.ts has no
# fallback for a missing database. Provisioned automatically by the
# Neon integration (Vercel Marketplace: `vercel integration add neon`);
# pull it into this file with `vercel env pull`. For a non-Vercel setup,
# paste a Neon (or any Postgres) connection string directly.
DATABASE_URL=

# Public site URL (used for canonical links, OG tags, CSP, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (USD giving + book store checkout). Leave blank to use the
# interactive local test-mode checkout instead of real Stripe Checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Required once STRIPE_SECRET_KEY is a real key, to verify
# /api/stripe/webhook signatures (Stripe Dashboard -> Webhooks).
STRIPE_WEBHOOK_SECRET=

# Tithe.ly hosted giving page (primary Donate/Give CTA target)
NEXT_PUBLIC_TITHELY_URL=https://tithe.ly/give?c=1848247

# YouTube (sermon archive + live stream)
YOUTUBE_CHANNEL_ID=UCbvgk_wBqP2XgyE40xgHOjA
# Optional. Without it: new-upload sync uses each channel's free RSS
# feed (15 most recent uploads, no live lookup), and the "LIVE NOW"
# badge falls back to the fixed weekly broadcast schedule. With it:
# full paginated upload history + a real check of whether either
# channel is actually live right now. Get one at
# https://console.cloud.google.com/apis/credentials (enable "YouTube
# Data API v3").
YOUTUBE_API_KEY=

# Secret Vercel Cron sends as `Authorization: Bearer <value>` to
# /api/cron/sync-youtube-videos (see vercel.json). Must be set for that
# endpoint to accept any request — leave blank to keep it disabled.
CRON_SECRET=

# Official ministry contact emails
GLM_ADDIS_EMAIL=addis@glministries.org
GLM_DC_EMAIL=dc@glministries.org

# Official ministry contact phone numbers
GLM_ADDIS_PHONE=+251-113-718847
GLM_DC_PHONE=+1-202-466-4642

# Official social/media presence
NEXT_PUBLIC_FACEBOOK_URL=https://web.facebook.com/EGLIC
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/EGLIC
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/glic_aware

# Ministry Admin Portal passcode (/[locale]/admin). Demo default is
# "2026" if left blank — override before sharing the portal link.
ADMIN_PASSCODE=
